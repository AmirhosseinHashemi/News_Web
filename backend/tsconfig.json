{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "types": ["node"],

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",

    "skipLibCheck": true,
    "sourceMap": true
  },

  "include": ["src/**/*.ts"],

  "exclude": ["node_modules", "dist"]
}
